# Application
FLASK_ENV=development
SECRET_KEY=change-me-in-production
HOST=0.0.0.0
PORT=5000
# To let phones use the microphone over a local network, serve HTTPS with a
# certificate whose SAN contains the computer's current LAN IP.  Install the
# matching local root CA on each phone; keep the private key outside version
# control.  Leave these unset for plain local HTTP development.
# TLS_CERT_FILE=/absolute/path/to/meeting-ai-lan-server.crt
# TLS_KEY_FILE=/absolute/path/to/meeting-ai-lan-server.key
# TLS_CA_CERT_FILE=/absolute/path/to/meeting-ai-lan-root-ca.crt
# SESSION_COOKIE_SECURE=1
# INTERNAL_LIVE_HOST=127.0.0.1
# INTERNAL_LIVE_SCHEME=https
# INTERNAL_LIVE_CA_FILE=/absolute/path/to/meeting-ai-lan-root-ca.crt

# Database
# Production MUST use PostgreSQL + pgvector. Example:
# DATABASE_URL=postgresql+psycopg://meeting:meeting@127.0.0.1:5432/meeting_ai
#
# Tests: if DATABASE_URL is unset, tests/conftest.py falls back to SQLite
# (file or in-memory) as a TEST DOUBLE only. Application code still uses
# the SQLAlchemy PostgreSQL dialect by default in non-testing configs.
DATABASE_URL=

# Data
DATA_DIR=./data
TIMEZONE=Asia/Shanghai

# Local audio-file import limits and offline speaker clustering.
IMPORT_MAX_BYTES=2147483648
IMPORT_MAX_DURATION_SECONDS=28800
IMPORT_WORKER_POLL_SECONDS=1.0
IMPORT_FFMPEG_TIMEOUT_SECONDS=7200
IMPORT_SPEAKER_CLUSTER_THRESHOLD=0.58
IMPORT_SPEAKER_SHORT_GAP_MS=3000
IMPORT_MAX_SPEAKERS=8

# Speech / LLM backends
# Production is strictly local. ``fake`` is only for development/tests.
SPEECH_BACKEND=funasr
LLM_BACKEND=qwen38
FUNASR_STREAMING_MODEL=funasr/paraformer-zh-streaming
# Real-time captions remain Paraformer streaming.  SenseVoiceSmall is best
# used after a VAD/Smart-Turn endpoint and for the final full-recording pass.
FUNASR_FINAL_MODEL=iic/SenseVoiceSmall
FUNASR_FINAL_BATCH_SIZE_S=300
SENSEVOICE_REFINEMENT_ENABLED=1
SENSEVOICE_MODEL=iic/SenseVoiceSmall
SENSEVOICE_VAD_MODEL=fsmn-vad
SENSEVOICE_DEVICE=cpu
SENSEVOICE_BATCH_SIZE_S=60
SENSEVOICE_MIN_UTTERANCE_MS=700
SENSEVOICE_MAX_UTTERANCE_MS=30000
SENSEVOICE_MIN_SIMILARITY=0.8
FUNASR_ONLINE_PUNC_MODEL=iic/punc_ct-transformer_zh-cn-common-vad_realtime-vocab272727
FUNASR_FINAL_PUNC_MODEL=iic/punc_ct-transformer_cn-en-common-vocab471067-large
FUNASR_CHUNK_MS=480
FUNASR_STABLE_TAIL_CHARS=1
# Optional whitespace-separated global hotwords; enabled terminology terms and aliases are added per meeting.
FUNASR_HOTWORDS=
FUNASR_ENCODER_LOOK_BACK=2
FUNASR_SPEAKER_MODEL=/absolute/path/to/campplus-local-snapshot
VAD_ENDPOINT_SILENCE_MS=250
VAD_HARD_CUT_MS=20000
VAD_ENERGY_THRESHOLD=50
# Smart Turn is a local ONNX end-of-turn classifier.  Download the model once
# into this path; application runtime never fetches it from the network.
SMART_TURN_ENABLED=1
SMART_TURN_MODEL_PATH=/absolute/path/to/smart-turn-v3.2-cpu.onnx
SMART_TURN_THRESHOLD=0.50
SMART_TURN_COMPLETE_REOPEN_MS=700
SMART_TURN_INCOMPLETE_REOPEN_MS=700
SMART_TURN_INCOMPLETE_DELAY_MS=500
SMART_TURN_CPU_COUNT=1

# Existing local Qwen3.8 OpenAI-compatible gateway. Do not expose it to browsers.
LOCAL_LLM_BASE_URL=http://127.0.0.1:8000/v1
LOCAL_LLM_MODEL=mtplx-qwen38-27b-optimized-quality
LOCAL_LLM_API_KEY=not-needed
LLM_TIMEOUT_SECONDS=90
LLM_MAX_CONCURRENCY=1
LLM_BACKGROUND_MAX_TOKENS=3072
REALTIME_BACKGROUND_LLM_ENABLED=1
CORRECTION_INTERVAL_SECONDS=30
CORRECTION_BATCH_CHARS=300

# TTS is local as well. MLX Qwen3-TTS uses Apple Silicon GPU; the model must
# already be present locally and is never downloaded by the application.
TTS_BACKEND=mlx
TTS_MLX_MODEL=/absolute/path/to/Qwen3-TTS-local-snapshot
TTS_MLX_VOICE=aiden
TTS_MLX_LANGUAGE=auto
TTS_MLX_INSTRUCT=请用稳定、中性、清晰的普通话连续播报。全程保持相同的语速、音高、响度和情绪；不要夸张重音、戏剧化停顿、情绪起伏或句末语气变化。
TTS_MLX_TEMPERATURE=0.30
TTS_MLX_TOP_K=20
TTS_MLX_TOP_P=0.90
TTS_MLX_STREAM_INTERVAL=0.32
TTS_MLX_REPETITION_PENALTY=1.20
TTS_MLX_MAX_TOKENS=1536
# Leave sampling and instruct unset to use the reference CustomVoice profile.
# TTS_MLX_INSTRUCT=
AI_TTS_EARLY_CHARS=36
AI_TTS_FOLLOWING_CHARS=72
AI_TTS_STREAM_BATCH_SENTENCES=4
AI_TTS_UNIT_MAX_CHARS=360
AI_TTS_DEFAULT_MAX_CHARS=1000
AI_TTS_DETAILED_MAX_CHARS=2000
AI_TTS_HARD_MAX_CHARS=2000
AI_TTS_TRANSPORT_BLOCK_SAMPLES=2048
AI_TTS_PLAYBACK_RATE=1.30
AI_TTS_MAX_PLAYBACK_RATE=1.60
AI_TTS_SHORT_REPLY_CHARS=28
AI_TTS_SHORT_TARGET_CHARS_PER_SECOND=5.0
AI_TTS_STREAM_BATCH_WAIT_MS=220
AI_BARGE_IN_MIN_CHARS=5
AI_BARGE_IN_MIN_SPEECH_MS=600
AI_BARGE_IN_SHORT_COMMAND_CHARS=3
AI_RESPONSE_MAX_TOKENS=3072
LLM_ENABLE_THINKING=0

# Speaker ID thresholds
SPEAKER_HIGH_CONFIDENCE=0.75
SPEAKER_MID_CONFIDENCE=0.55
SPEAKER_ID_MIN_MS=1500
SPEAKER_CLUSTER_MATCH_THRESHOLD=0.45

# Live
HOST_TRANSFER_MAX_GAP_MS=2000
CHUNK_TIMESLICE_MS=5000
PCM_FRAME_MS=100
PCM_SAMPLE_RATE=16000

# Tests
RUN_LOCAL_LLM=0
